# ==============================================================================
# FactoryIQ / SIH_Sarthak - Production-Ready Git Ignore Rules
# Stack: Next.js 15, React, TypeScript, Prisma (SQLite/PostgreSQL), Vitest, Tailwind
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Files (CRITICAL SECURITY)
# Never commit real secrets, API keys, tokens, or environment credentials.
# ------------------------------------------------------------------------------
.env
.env*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.kdb
credentials.json
secrets.json

# ------------------------------------------------------------------------------
# 2. Dependencies
# Installed packages must be recreated using package-lock.json / npm install.
# ------------------------------------------------------------------------------
/node_modules
/.pnpm-store

# ------------------------------------------------------------------------------
# 3. Next.js & Build Outputs
# Compiled artifacts, build bundles, and serverless outputs.
# ------------------------------------------------------------------------------
/.next/
/out/
/build/
/dist/
/.vercel
/.turbo

# ------------------------------------------------------------------------------
# 4. TypeScript & Compiler Caches
# Build info and incremental compilation artifacts.
# ------------------------------------------------------------------------------
*.tsbuildinfo
tsconfig.tsbuildinfo
.tscache/

# ------------------------------------------------------------------------------
# 5. Database & Local Data Storage
# Ignore local SQLite databases, dev databases, and journal files.
# NOTE: Schema files (prisma/schema.prisma) and migrations are version controlled.
# ------------------------------------------------------------------------------
prisma/*.db
prisma/*.db-journal
prisma/*.sqlite
prisma/*.sqlite-journal
*.db
*.db-journal
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 6. Logs & Debugging
# System, process, and package manager log dumps.
# ------------------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 7. Testing & Coverage
# Output directories generated by Vitest / Jest / Playwright test runs.
# ------------------------------------------------------------------------------
/coverage/
/.vitest/
/test-results/
/playwright-report/
/blob-report/
.nyc_output/

# ------------------------------------------------------------------------------
# 8. IDE & Code Editor Files
# Developer-specific settings and workspace states.
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 9. Operating System Files
# Files generated by macOS, Windows, and Linux operating systems.
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory

# ------------------------------------------------------------------------------
# 10. Temporary & Scratch Files
# Agent scratchpads, temp directories, and workspace dumps.
# ------------------------------------------------------------------------------
/tmp/
/temp/
*.tmp
